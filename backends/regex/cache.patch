 impl Cache {
+    /// Task-local proof: fallible bounded capture-free Input cache.
+    pub fn cui_try_new(re: &PikeVM, budget: usize) -> Result<Cache, &'static str> {
+        if re.get_nfa().group_info().slot_len() != 0 { return Err("captures unsupported"); }
