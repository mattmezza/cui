# Deploy a development bundle after transferring a cross build to a Mac.
# cmake -DAPP=/absolute/app.app -DDEPENDENCY_PREFIX=/absolute/target-prefix -P scripts/deploy_macos_bundle.cmake
cmake_minimum_required(VERSION 3.20)
if(NOT CMAKE_HOST_APPLE)
 message(FATAL_ERROR "Bundle deployment must run on macOS")
endif()
if(NOT IS_ABSOLUTE "${APP}" OR NOT EXISTS "${APP}/Contents/Info.plist")
 message(FATAL_ERROR "APP must be an absolute path to a built .app")
endif()
if(NOT IS_ABSOLUTE "${DEPENDENCY_PREFIX}" OR NOT IS_DIRECTORY "${DEPENDENCY_PREFIX}/lib")
 message(FATAL_ERROR "DEPENDENCY_PREFIX must contain the target dependency lib directory")
endif()
if(IS_DIRECTORY "${DEPENDENCY_PREFIX}/share/licenses")
 file(COPY "${DEPENDENCY_PREFIX}/share/licenses/" DESTINATION "${APP}/Contents/Resources/licenses/native")
endif()
include(BundleUtilities)
fixup_bundle("${APP}" "" "${DEPENDENCY_PREFIX}/lib")
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/CUISignMacOS.cmake")
cui_sign_macos_development_bundle("${APP}")
message(STATUS "Development dependencies deployed and ad-hoc signed. Developer ID distribution is separate.")
