# Shared with the native source bundle and portable header generator.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/sources.json")
file(READ "${CMAKE_CURRENT_LIST_DIR}/sources.json" CUI_SOURCE_METADATA)
function(cui_source_array output)
 string(JSON count LENGTH "${CUI_SOURCE_METADATA}" ${ARGN})
 set(values)
 if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
   string(JSON value GET "${CUI_SOURCE_METADATA}" ${ARGN} ${index})
   list(APPEND values "${value}")
  endforeach()
 endif()
 set(${output} "${values}" PARENT_SCOPE)
endfunction()
string(JSON module_count LENGTH "${CUI_SOURCE_METADATA}" modules)
math(EXPR module_last "${module_count} - 1")
set(CUI_PORTABLE_SOURCES)
foreach(index RANGE ${module_last})
 string(JSON module MEMBER "${CUI_SOURCE_METADATA}" modules ${index})
 cui_source_array(module_sources modules ${module})
 list(APPEND CUI_PORTABLE_SOURCES ${module_sources})
endforeach()
list(REMOVE_DUPLICATES CUI_PORTABLE_SOURCES)
foreach(adapter text bidi sheenbidi sdl3 software)
 string(TOUPPER "${adapter}" upper)
 cui_source_array(CUI_${upper}_SOURCES native ${adapter})
endforeach()
