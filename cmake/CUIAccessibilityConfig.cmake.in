# SPDX-License-Identifier: MIT
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
 message(FATAL_ERROR "CUI AccessKit package supports Linux only")
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
get_filename_component(_cui_accessibility_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET CUI::accesskit_dependency)
 add_library(CUI::accesskit_dependency STATIC IMPORTED)
 set_target_properties(CUI::accesskit_dependency PROPERTIES IMPORTED_LOCATION "${_cui_accessibility_prefix}/lib/libaccesskit.a")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CUIAccessibilityTargets.cmake")
unset(_cui_accessibility_prefix)
