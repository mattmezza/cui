# SPDX-License-Identifier: MIT
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_CROSSCOMPILING)
 message(FATAL_ERROR "CUI regex native archive receipt supports native Linux only")
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
get_filename_component(_cui_regex_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET CUI::cui)
 add_library(CUI::cui STATIC IMPORTED)
 set_target_properties(CUI::cui PROPERTIES IMPORTED_LOCATION "${_cui_regex_prefix}/lib/libcui.a" INTERFACE_INCLUDE_DIRECTORIES "${_cui_regex_prefix}/include" INTERFACE_LINK_LIBRARIES m)
endif()
if(NOT TARGET CUI::cui_regex)
 add_library(CUI::cui_regex STATIC IMPORTED)
 set_target_properties(CUI::cui_regex PROPERTIES IMPORTED_LOCATION "${_cui_regex_prefix}/lib/libcui_regex.a" INTERFACE_INCLUDE_DIRECTORIES "${_cui_regex_prefix}/include" INTERFACE_LINK_LIBRARIES "CUI::cui;gcc_s;util;rt;Threads::Threads;m;${CMAKE_DL_LIBS}")
endif()
unset(_cui_regex_prefix)
