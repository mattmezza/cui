# Development-only signing after install_name_tool has changed Mach-O files.
function(cui_sign_macos_development_bundle app)
 if(NOT CMAKE_HOST_APPLE)
  message(FATAL_ERROR "Development bundle signing requires macOS")
 endif()
 find_program(CUI_CODESIGN codesign REQUIRED)
 file(GLOB_RECURSE libraries "${app}/Contents/*.dylib")
 set(items)
 foreach(library IN LISTS libraries)
  get_filename_component(real "${library}" REALPATH)
  list(APPEND items "${real}")
 endforeach()
 list(REMOVE_DUPLICATES items)
 file(GLOB frameworks "${app}/Contents/Frameworks/*.framework")
 list(APPEND items ${frameworks} "${app}")
 foreach(item IN LISTS items)
  execute_process(COMMAND "${CUI_CODESIGN}" --force --sign - "${item}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
   message(FATAL_ERROR "Development signing failed for ${item}: ${status}")
  endif()
 endforeach()
 execute_process(COMMAND "${CUI_CODESIGN}" --verify --deep --strict "${app}" RESULT_VARIABLE status)
 if(NOT status EQUAL 0)
  message(FATAL_ERROR "Development signature verification failed: ${status}")
 endif()
endfunction()
