# SPDX-License-Identifier: MIT
# Optional production package. No Cargo invocation or network fetch.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
 message(FATAL_ERROR "CUI AccessKit phase1 supports Linux only")
endif()
if(CMAKE_CROSSCOMPILING)
 message(FATAL_ERROR "AccessKit private cache is host-built; cross compilation is not supported by this package")
endif()
set(ACCESSKIT_CACHE "$ENV{HOME}/.cache/cui-accesskit" CACHE PATH "Pinned prebuilt private dependency cache")
get_filename_component(CUI_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(READ "${CUI_ROOT}/third_party/accesskit/pin.json" PIN)
file(READ "${CMAKE_CURRENT_LIST_DIR}/extension.json" EXTENSION)
string(JSON ACCESSKIT_COMMIT GET "${PIN}" commit)
set(ACCESSKIT_SOURCE "${ACCESSKIT_CACHE}/accesskit-c-${ACCESSKIT_COMMIT}")
set(ACCESSKIT_ARCHIVE "${ACCESSKIT_CACHE}/target/release/libaccesskit.a")
function(cui_accesskit_verify file expected)
 if(NOT EXISTS "${file}")
  message(FATAL_ERROR "Missing optional AccessKit cache file: ${file}. Run scripts/build_accesskit.py first.")
 endif()
 file(SHA256 "${file}" actual)
 if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Pinned AccessKit checksum mismatch: ${file}")
 endif()
endfunction()
string(JSON HASH GET "${PIN}" archive_sha256)
cui_accesskit_verify("${ACCESSKIT_CACHE}/${ACCESSKIT_COMMIT}.tar.gz" "${HASH}")
string(JSON HASH GET "${PIN}" cargo_lock_sha256)
cui_accesskit_verify("${ACCESSKIT_SOURCE}/Cargo.lock" "${HASH}")
string(JSON HASH GET "${EXTENSION}" lib_rs_sha256)
cui_accesskit_verify("${ACCESSKIT_SOURCE}/src/lib.rs" "${HASH}")
string(JSON HASH GET "${EXTENSION}" shim_sha256)
cui_accesskit_verify("${ACCESSKIT_SOURCE}/src/cui_lifetime.rs" "${HASH}")
if(NOT EXISTS "${ACCESSKIT_ARCHIVE}" OR NOT EXISTS "${ACCESSKIT_SOURCE}/include/accesskit.h")
 message(FATAL_ERROR "Prebuild pinned AccessKit with scripts/build_accesskit.py; CMake never invokes Cargo or downloads dependencies")
endif()
# Header SHA is from the verified pristine 0.23.0 archive.
cui_accesskit_verify("${ACCESSKIT_SOURCE}/include/accesskit.h" "1a99c7a8dac2f5b4fa99ab323d0274ab5a3bbac8bee02220ef941cde4d36af4f")
file(SHA256 "${ACCESSKIT_ARCHIVE}" ACCESSKIT_LIBRARY_SHA256)
configure_file("${CUI_ROOT}/cmake/accesskit-build.json.in" accesskit-build.json @ONLY)
find_package(Threads REQUIRED)
add_library(cui_accesskit_dependency STATIC IMPORTED GLOBAL)
set_target_properties(cui_accesskit_dependency PROPERTIES IMPORTED_LOCATION "${ACCESSKIT_ARCHIVE}")
add_library(cui_accessibility STATIC cui_accessibility.c)
target_include_directories(cui_accessibility PRIVATE "${ACCESSKIT_SOURCE}/include")
target_link_libraries(cui_accessibility PUBLIC cui Threads::Threads $<BUILD_INTERFACE:cui_accesskit_dependency> $<INSTALL_INTERFACE:CUI::accesskit_dependency> ${CMAKE_DL_LIBS} m)
cui_warnings(cui_accessibility)
# Counter/injection ABI is validation-only and never installed.
add_library(cui_accessibility_testing STATIC cui_accessibility.c)
target_compile_definitions(cui_accessibility_testing PRIVATE CUI_A11Y_TESTING=1)
target_include_directories(cui_accessibility_testing PRIVATE "${ACCESSKIT_SOURCE}/include")
target_link_libraries(cui_accessibility_testing PUBLIC cui Threads::Threads cui_accesskit_dependency ${CMAKE_DL_LIBS} m)
cui_warnings(cui_accessibility_testing)
add_executable(test_accessibility "${CUI_ROOT}/tests/unit/test_accessibility.c")
target_include_directories(test_accessibility PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
target_link_libraries(test_accessibility PRIVATE cui_accessibility_testing)
cui_warnings(test_accessibility)
add_test(NAME accessibility COMMAND test_accessibility)
if(PkgConfig_FOUND)
 pkg_check_modules(ATSPI QUIET IMPORTED_TARGET atspi-2 gobject-2.0)
endif()
find_program(CUI_ACCESSKIT_DBUS dbus-run-session)
find_program(CUI_ACCESSKIT_XVFB xvfb-run)
find_program(CUI_ACCESSKIT_GDBUS gdbus)
if(TARGET cui_sdl3 AND ATSPI_FOUND AND CUI_ACCESSKIT_DBUS AND CUI_ACCESSKIT_XVFB AND CUI_ACCESSKIT_GDBUS)
 add_executable(test_accessibility_native "${CUI_ROOT}/tests/integration/test_accessibility_native.c")
 target_include_directories(test_accessibility_native PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
 target_link_libraries(test_accessibility_native PRIVATE cui_accessibility_testing cui_sdl3 PkgConfig::ATSPI ${CUI_SDL_TARGET})
 cui_warnings(test_accessibility_native)
 add_test(NAME accessibility_native COMMAND "${CMAKE_CURRENT_LIST_DIR}/run_native.sh" $<TARGET_FILE:test_accessibility_native>)
 set_tests_properties(accessibility_native PROPERTIES TIMEOUT 30 ENVIRONMENT "ASAN_OPTIONS=detect_leaks=0")
else()
 message(STATUS "AccessKit native test omitted: requires SDL3/text, libAT-SPI, DBus, gdbus and Xvfb")
endif()
install(TARGETS cui cui_accessibility EXPORT CUIAccessibilityTargets ARCHIVE DESTINATION lib)
install(FILES "${ACCESSKIT_ARCHIVE}" DESTINATION lib RENAME libaccesskit.a)
install(EXPORT CUIAccessibilityTargets FILE CUIAccessibilityTargets.cmake NAMESPACE CUI:: DESTINATION lib/cmake/CUIAccessibility)
configure_file("${CUI_ROOT}/cmake/CUIAccessibilityConfig.cmake.in" CUIAccessibilityConfig.cmake @ONLY)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/CUIAccessibilityConfig.cmake" DESTINATION lib/cmake/CUIAccessibility)
set(CUI_ACCESSKIT_PC_SANITIZE "")
if(CUI_SANITIZE)
 set(CUI_ACCESSKIT_PC_SANITIZE "-fsanitize=address,undefined")
endif()
configure_file("${CUI_ROOT}/cmake/accessibility.pc.in" cui-accessibility.pc @ONLY)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/cui-accessibility.pc" DESTINATION lib/pkgconfig)
install(DIRECTORY "${CUI_ROOT}/third_party/accesskit/" DESTINATION share/cui/licenses/accesskit FILES_MATCHING PATTERN "LICENSE*" PATTERN "pin.json" PATTERN "README.md")
install(FILES "${CMAKE_CURRENT_LIST_DIR}/extension.json" "${CMAKE_CURRENT_BINARY_DIR}/accesskit-build.json" DESTINATION share/cui/licenses/accesskit)

add_test(NAME accessibility_package COMMAND "${Python3_EXECUTABLE}" "${CUI_ROOT}/tests/packaging/test_accessibility_package.py" --build "${CMAKE_BINARY_DIR}")
set_tests_properties(accessibility_package PROPERTIES TIMEOUT 120)
