# Caller supplies an OSXCross compiler, licensed Apple SDK and target dependencies.
set(CMAKE_SYSTEM_NAME Darwin)
foreach(required CUI_MACOS_CC CUI_MACOS_SDK CUI_MACOS_PREFIX CUI_MACOS_ARCH CUI_MACOS_DEPLOYMENT_TARGET)
 if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
  message(FATAL_ERROR "${required} must be supplied; see docs/MACOS_CROSS.md")
 endif()
endforeach()
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CUI_MACOS_CC CUI_MACOS_SDK CUI_MACOS_PREFIX CUI_MACOS_ARCH CUI_MACOS_DEPLOYMENT_TARGET)
set(CMAKE_C_COMPILER "${CUI_MACOS_CC}")
set(CMAKE_OSX_SYSROOT "${CUI_MACOS_SDK}" CACHE PATH "Apple SDK" FORCE)
set(CMAKE_OSX_ARCHITECTURES "${CUI_MACOS_ARCH}" CACHE STRING "Target architecture" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET "${CUI_MACOS_DEPLOYMENT_TARGET}" CACHE STRING "Minimum macOS" FORCE)
set(CMAKE_SYSTEM_PROCESSOR "${CUI_MACOS_ARCH}")
set(CMAKE_FIND_ROOT_PATH "${CUI_MACOS_PREFIX}" "${CUI_MACOS_SDK}")
set(CMAKE_PREFIX_PATH "${CUI_MACOS_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY FALSE)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY FALSE)
# Absolute .pc paths already refer to the staged target prefix: do not sysroot twice.
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${CUI_MACOS_PREFIX}/lib/pkgconfig:${CUI_MACOS_PREFIX}/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "")
